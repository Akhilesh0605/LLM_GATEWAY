# ============================================================
# LLM Gateway — environment template
# Copy to `.env` for local Docker, or set these as env vars in
# your host (Render) + managed services (Neon, Upstash).
# ============================================================

# Redis connection string.
#   Upstash  -> rediss://default:<password>@<host>:<port>   (TLS, note rediss)
#   Local    -> redis://redis:6379
REDIS_SERVER_LINK=redis://localhost:6379

# PostgreSQL connection string (SQLAlchemy asyncpg driver).
#   Neon     -> postgresql+asyncpg://<user>:<pass>@<host>/<db>?ssl=require
#   Local    -> postgresql+asyncpg://user:password@postgres:5432/llmgateway
# NOTE: asyncpg needs `ssl=require`, NOT `sslmode=require`.
POSTGRESQL_LINK=postgresql+asyncpg://user:password@localhost:5432/llmgateway

# Fernet key used to encrypt BYOK provider keys at rest.
# MUST remain constant across deploys or stored keys become undecryptable.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-stable-fernet-key

# ------------------------------------------------------------
# Optional tuning (defaults shown). Safe to omit.
# ------------------------------------------------------------
SIMILARITY_THRESHOLD_SIMPLE=0.90
SIMILARITY_THRESHOLD_MEDIUM=0.92
SIMILARITY_THRESHOLD_COMPLEX=0.95
CACHE_TTL_SIMPLE=7200
CACHE_TTL_MEDIUM=3600
CACHE_TTL_COMPLEX=1800
DAILY_BUDGET_USD=10.0
EVALUATION_LOOP_RATE=0.10
